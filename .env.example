# Variables para la Guía EduContext (chat conversacional con Gemini).
# En Webflow Cloud: Apps → tu app → Settings → Environment Variables.
# Nunca commitear el valor real de la key.
# Conseguí tu key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional — verificá el nombre de modelo vigente en https://ai.google.dev
GEMINI_MODEL=gemini-3.5-flash
